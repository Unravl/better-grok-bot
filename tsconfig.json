{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"bun"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"paths": {
			"@better-grok-bot/sdk": [
				"./sdk/index.ts"
			]
		}
	},
	"include": [
		"sdk",
		"core",
		"loader",
		"plugins",
		"scripts"
	]
}
